{
  "name": "Online Boutique",
  "details": {
    "description": "Cloud-first microservices demo application. Web-based e-commerce app where users can browse items, add them to the cart, and purchase them. Composed of 11 microservices that talk to each other over gRPC (plus a Redis cache used by cart).",
    "source": {
      "vcs": "git",
      "url": "https://github.com/GoogleCloudPlatform/microservices-demo",
      "revision": "ca9a7a623155500a37b92acfee025d388d4ce128"
    }
  },
  "blocks": [
    {
      "name": "frontend",
      "details": {
        "service": "frontend",
        "description": "Exposes an HTTP server to serve the website. Does not require signup/login and generates session IDs for all users automatically.",
        "language": "Go",
        "resources": {
          "requests": { "cpu": "100m", "memory": "64Mi" },
          "limits": { "cpu": "200m", "memory": "128Mi" }
        }
      },
      "downstream": [
        { "to_block_name": "ad", "details": { "description": "gRPC call" } },
        { "to_block_name": "recommendation", "details": { "description": "gRPC call" } },
        { "to_block_name": "productcatalog", "details": { "description": "gRPC call" } },
        { "to_block_name": "cart", "details": { "description": "gRPC call" } },
        { "to_block_name": "shipping", "details": { "description": "gRPC call" } },
        { "to_block_name": "currency", "details": { "description": "gRPC call" } },
        { "to_block_name": "checkout", "details": { "description": "gRPC call" } }
      ]
    },
    {
      "name": "checkout",
      "details": {
        "service": "checkoutservice",
        "description": "Retrieves user cart, prepares order and orchestrates the payment, shipping and the email notification.",
        "language": "Go",
        "resources": {
          "requests": { "cpu": "100m", "memory": "64Mi" },
          "limits": { "cpu": "200m", "memory": "128Mi" }
        }
      },
      "downstream": [
        { "to_block_name": "payment", "details": { "description": "gRPC call" } },
        { "to_block_name": "shipping", "details": { "description": "gRPC call" } },
        { "to_block_name": "email", "details": { "description": "gRPC call" } },
        { "to_block_name": "currency", "details": { "description": "gRPC call" } },
        { "to_block_name": "productcatalog", "details": { "description": "gRPC call" } },
        { "to_block_name": "cart", "details": { "description": "gRPC call" } }
      ]
    },
    {
      "name": "cart",
      "details": {
        "service": "cartservice",
        "description": "Stores the items in the user's shopping cart in Redis and retrieves it.",
        "language": "C#",
        "resources": {
          "requests": { "cpu": "200m", "memory": "64Mi" },
          "limits": { "cpu": "300m", "memory": "128Mi" }
        }
      },
      "downstream": [
        { "to_block_name": "redis-cache", "details": { "description": "Redis protocol (cart storage)" } }
      ]
    },
    {
      "name": "productcatalog",
      "details": {
        "service": "productcatalogservice",
        "description": "Provides the list of products from a JSON file and ability to search products and get individual products.",
        "language": "Go",
        "resources": {
          "requests": { "cpu": "100m", "memory": "64Mi" },
          "limits": { "cpu": "200m", "memory": "128Mi" }
        }
      },
      "downstream": []
    },
    {
      "name": "currency",
      "details": {
        "service": "currencyservice",
        "description": "Converts one money amount to another currency. Uses real values fetched from European Central Bank. It's the highest QPS service.",
        "language": "Node.js",
        "resources": {
          "requests": { "cpu": "100m", "memory": "64Mi" },
          "limits": { "cpu": "200m", "memory": "128Mi" }
        }
      },
      "downstream": []
    },
    {
      "name": "payment",
      "details": {
        "service": "paymentservice",
        "description": "Charges the given credit card info (mock) with the given amount and returns a transaction ID.",
        "language": "Node.js",
        "resources": {
          "requests": { "cpu": "100m", "memory": "64Mi" },
          "limits": { "cpu": "200m", "memory": "128Mi" }
        }
      },
      "downstream": []
    },
    {
      "name": "shipping",
      "details": {
        "service": "shippingservice",
        "description": "Gives shipping cost estimates based on the shopping cart. Ships items to the given address (mock).",
        "language": "Go",
        "resources": {
          "requests": { "cpu": "100m", "memory": "64Mi" },
          "limits": { "cpu": "200m", "memory": "128Mi" }
        }
      },
      "downstream": []
    },
    {
      "name": "email",
      "details": {
        "service": "emailservice",
        "description": "Sends users an order confirmation email (mock).",
        "language": "Python",
        "resources": {
          "requests": { "cpu": "100m", "memory": "64Mi" },
          "limits": { "cpu": "200m", "memory": "128Mi" }
        }
      },
      "downstream": []
    },
    {
      "name": "recommendation",
      "details": {
        "service": "recommendationservice",
        "description": "Recommends other products based on what's given in the cart.",
        "language": "Python",
        "resources": {
          "requests": { "cpu": "100m", "memory": "220Mi" },
          "limits": { "cpu": "200m", "memory": "450Mi" }
        }
      },
      "downstream": [
        { "to_block_name": "productcatalog", "details": { "description": "gRPC call" } }
      ]
    },
    {
      "name": "ad",
      "details": {
        "service": "adservice",
        "description": "Provides text ads based on given context words.",
        "language": "Java",
        "resources": {
          "requests": { "cpu": "200m", "memory": "180Mi" },
          "limits": { "cpu": "300m", "memory": "300Mi" }
        }
      },
      "downstream": []
    },
    {
      "name": "loadgenerator",
      "details": {
        "service": "loadgenerator",
        "description": "Continuously sends requests imitating realistic user shopping flows to the frontend.",
        "language": "Python (Locust)",
        "resources": {
          "requests": { "cpu": "300m", "memory": "256Mi" },
          "limits": { "cpu": "500m", "memory": "512Mi" }
        }
      },
      "downstream": [
        { "to_block_name": "frontend", "details": { "description": "HTTP requests (traffic generation)" } }
      ]
    },
    {
      "name": "redis-cache",
      "details": {
        "service": "redis-cart",
        "description": "Redis cache used by cartservice to store shopping cart state.",
        "language": "N/A",
        "resources": {
          "requests": { "cpu": "70m", "memory": "200Mi" },
          "limits": { "cpu": "125m", "memory": "256Mi" }
        }
      },
      "downstream": []
    }
  ]
}